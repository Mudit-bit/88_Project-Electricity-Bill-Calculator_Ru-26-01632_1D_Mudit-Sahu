# Project: Electricity Bill Calculator
name = input("Enter consumer name: ")
try:
    units = float(input("Enter units consumed: "))

    if units < 0:
        print("Invalid units. Enter a non-negative number.")

    elif units <= 100:
        energy = units * 3

    elif units <= 200:
        energy = 300 + (units - 100) * 5

    else:
        energy = 800 + (units - 200) * 8

    if units >= 0:
        fixed = 50
        tax = (energy + fixed) * 5 / 100
        total = energy + fixed + tax

        print("\n----- ELECTRICITY BILL -----")
        print("Consumer Name:", name)
        print("Energy: %.2f" % energy)
        print("Fixed: %.2f" % fixed)
        print("Tax: %.2f" % tax)
        print("Total Bill: %.2f" % total)

except ValueError:
    print("Invalid units. Enter a non-negative number.")